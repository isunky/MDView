{
  "manifest_version": 3,
  "name": "MDView",
  "description": "A focused Markdown reader and editor.",
  "version": "3.1.1",
  "action": {
    "default_title": "Open with MDView"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "file:///*"
  ],
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  }
}
