{
  "name": "mdview",
  "private": true,
  "version": "3.8.0",
  "overrides": {
    "katex": "$katex",
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "build": "node ./node_modules/@typescript/native/bin/tsc -b && vite build && npm run bundle:check",
    "edge:build": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.edge.json && vite build --config vite.edge.config.ts",
    "edge:package": "npm run edge:build && node scripts/package-edge-extension.mjs",
    "bundle:check": "node scripts/check-startup-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "version:check": "node scripts/check-version.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "portable:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-portable.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "docx": "^9.15.3",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "mermaid-legacy": "npm:mermaid@^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "jszip": "^3.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  }
}
